# Application
APP_NAME=Campus Connect Assistant API
APP_DESCRIPTION=API de l'assistant virtuel éducatif du Campus ESIC
APP_VERSION=1.1.0
APP_ENVIRONMENT=development

# PostgreSQL
POSTGRES_DB=campus_connect
POSTGRES_USER=campus_user
POSTGRES_PASSWORD=change_me
POSTGRES_HOST_PORT=5433

# SQLAlchemy - backend lancé localement
DATABASE_URL=postgresql+psycopg://campus_user:change_me@127.0.0.1:5433/campus_connect

# SQLAlchemy - backend lancé dans Docker
DOCKER_DATABASE_URL=postgresql+psycopg://campus_user:change_me@postgres:5432/campus_connect

# Base de tests (optionnel). Par defaut, les tests derivent l'URL de
# DATABASE_URL en ajoutant le suffixe "_test" au nom de base
# (ex. campus_connect_test). La base est creee et migree automatiquement.
# Garde-fou : le nom de base doit se terminer par "_test".
# TEST_DATABASE_URL=postgresql+psycopg://campus_user:change_me@127.0.0.1:5433/campus_connect_test

# Cle d'acces a GET /api/analytics/summary (en-tete X-Analytics-Key).
# Laisser vide pour desactiver l'endpoint (HTTP 503).
ANALYTICS_API_KEY=

# Port hote du front nginx (demo Docker complete). 8080 est souvent reserve par Windows.
WEB_HOST_PORT=8088

# IoT (bornes/capteurs simules)
IOT_DEVICE_KEY=
IOT_ONLINE_THRESHOLD_SECONDS=120
